# ========================================
# DOCKER COMPOSE PRODUCTION ENVIRONMENT EXAMPLE
# ========================================
# Copy file này thành .env.production và điền thông tin thực

# API URL for Frontend Build
VITE_API_URL=http://localhost:5000/api

# MySQL Configuration (Nếu dùng Docker MySQL)
DB_ROOT_PASSWORD=your_strong_root_password_here
DB_DATABASE=vicc_production
DB_USER=vicc_user
DB_PASSWORD=your_strong_user_password_here

# Volumes
MYSQL_DATA_PATH=./data/mysql
